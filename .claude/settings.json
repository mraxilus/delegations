{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" start",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" path"}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" bash"}
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" body"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" edit"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks.sh\" stop"}
        ]
      }
    ]
  }
}
