# Nim build products: compiler cache, testament results, built binaries, koch itself. Path is
# name (Article V.9), so binaries sit in `binaries/`; `bin/` stays ignored, since audit reads
# untracked files and older checkout may still hold one.
nimcache/
testresults/
binaries/
bin/
/koch

# Nim toolchain installed into workspace by setup action or by hand; audit reads untracked
# files, so toolchain left visible adds whole source of Nim to audit.
.nim_runtime/

# Testament test binaries sit beside their sources, in every project; leading `**/` keeps
# pattern with inner slash unanchored. Suites one entry joins sit in `suites/`, and binary of
# one built alone lands beside it. `t*` covers `test_<name>` and older `t<name>` alike.
**/tests/t*
!**/tests/*.nim
**/tests/suites/t*
!**/tests/suites/*.nim

# Pages, pictures and scripts projects build; pattern without slash matches at any depth.
build/

# Atlas checkouts and caches; nimble file, atlas.config, atlas.lock and nim.cfg are
# committed, clones never (Article XI.3). Checkouts sit in `dependencies/` (Article V.9);
# `deps/` is where Atlas restores when `atlas.config` names no folder.
**/dependencies/
**/deps/
*.nimble-link
deps.dot
deps.png

# Node build products, for TypeScript projects.
node_modules/
dist/
