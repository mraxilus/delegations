#   derived here from CLL, never imported (II.8).

version = "0.1.0"
author = "Emmanuel M. Smith"
description = "Tag anything with Lojban gismu and lujvo, and find it again by gismu or English."
license = "Prosperity-3.0.0"
srcDir = "src"

requires "nim == 2.2.12"
