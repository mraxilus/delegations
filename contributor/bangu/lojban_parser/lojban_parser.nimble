# lo skicu be le bakfu be'o noi la'o gy. Atlas .gy. .e la'o gy. nimble .gy. cu tcidu ke'a .i lo se
#   nitcu be le bakfu cu zvati vi to `Article II.8` toi
#   .i le vi se gunka cu nitcu le fadni samtci pe la'o gy. Nim .gy. po'o .i le vi se gunka cu zasti
#     mu'i lo nu jimpe la lojban. .i se ki'u bo la lojban. cu se zbasu vi fi la'o gy. CLL .gy. gi'e
#     no roi se cpacu to `Article II.8` toi

version = "0.1.0"
author = "Emmanuel M. Smith"
description = "Parse lojban words, as CLL defines them."
license = "Prosperity-3.0.0"
srcDir = "src"

requires "nim == 2.4.0"
