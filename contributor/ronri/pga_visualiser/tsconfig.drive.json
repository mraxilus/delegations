{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "rootDir": "tools/drive",
    "outDir": "build/drive",
    "removeComments": true,
    "newLine": "lf"
  },
  "include": ["tools/drive/**/*.ts", "build/bridge.d.ts"]
}
